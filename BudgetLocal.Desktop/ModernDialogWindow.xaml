<Window x:Class="BudgetLocal.Desktop.ModernDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BudgetLocal" SizeToContent="WidthAndHeight" MinWidth="390" MaxWidth="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F6FA" Language="fr-BE" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Foreground="#172B4D" TextWrapping="Wrap"/>
            <TextBlock x:Name="DialogMessage" FontSize="14" Foreground="#52606D" Margin="0,10,0,4" TextWrapping="Wrap" MaxWidth="500"/>
        </StackPanel>
        <WrapPanel x:Name="DialogButtons" Grid.Row="1" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</Window>
