<Window x:Class="BudgetLocal.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Icon="pack://application:,,,/Assets/BudgetLocal.ico"
        Title="BudgetLocal — Budget personnel" Height="980" Width="1440" MinHeight="670" MinWidth="920"
        Background="#F4F6FA" WindowStartupLocation="CenterScreen" Language="fr-BE" FontFamily="Segoe UI">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#172B4D">
            <DockPanel Margin="16" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="BudgetLocal" FontSize="25" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Votre budget, simplement" Foreground="#C5D3E8" Margin="0,5,0,28"/>
                    <Button Content="⌂  Tableau de bord" Command="{Binding DashboardCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="▤  Graphiques" Command="{Binding ChartsCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="BUDGET ACTIF" Foreground="#B8C7DC" FontSize="11" Margin="7,18,0,5"/>
                    <ComboBox ItemsSource="{Binding Budgets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedBudget}"/>
                    <Button Content="＋  Gérer les budgets" Command="{Binding ManageBudgetsCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="VOS DONNÉES" Foreground="#B8C7DC" FontSize="11" Margin="7,22,0,5"/>
                    <Button Content="⇧  Exporter" Command="{Binding ExportCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="⇩  Importer" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch"/>
                    <Button Content="▣  Créer une sauvegarde" Command="{Binding BackupCommand}" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" Padding="5,8" FontSize="13" ToolTip="Créer une sauvegarde"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Content="Réinitialiser mon budget" Background="#9B3A43"
                            Command="{Binding ResetBudgetCommand}" HorizontalAlignment="Stretch" Margin="0,18,0,8"/>
                    <TextBlock Text="Propriété de Delguste François" Foreground="#B8C7DC" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,2"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsDashboardPage,Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24">
                <TextBlock Text="{Binding SelectedBudget.Name}" FontSize="30" FontWeight="SemiBold" Foreground="#172B4D"/>
                <TextBlock Text="Tableau de bord · vue indépendante de ce budget." Foreground="#64748B" Margin="0,4,0,16"/>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Background="White" CornerRadius="12" Padding="14" Margin="3"><StackPanel><TextBlock Text="Solde du mois" Foreground="#64748B"/><TextBlock Text="{Binding BalanceText}" FontSize="20" FontWeight="SemiBold" Foreground="#2864B4" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="12" Padding="14" Margin="3"><StackPanel><TextBlock Text="Revenus du mois" Foreground="#64748B"/><TextBlock Text="{Binding IncomeText}" FontSize="20" FontWeight="SemiBold" Foreground="#18794E" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="12" Padding="14" Margin="3"><StackPanel><TextBlock Text="Dépenses du mois" Foreground="#64748B"/><TextBlock Text="{Binding ExpensesText}" FontSize="20" FontWeight="SemiBold" Foreground="#B42318" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="White" CornerRadius="12" Padding="14" Margin="3"><StackPanel><TextBlock Text="Activité" Foreground="#64748B"/><TextBlock Text="{Binding MonthlyCountText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                </UniformGrid>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ajouter une transaction" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D"/>
                        <TextBlock Text="Chaque opération est enregistrée séparément, même lorsqu’elle partage une catégorie." Foreground="#64748B" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Montant (€)" Margin="3,2"/><TextBox Width="145" Text="{Binding Amount,UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. : 45,90"/></StackPanel>
                            <StackPanel><TextBlock Text="Libellé" Margin="3,2"/><TextBox Width="210" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Type" Margin="3,2"/><ComboBox Width="140" ItemsSource="{Binding TransactionTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedType}"/></StackPanel>
                            <StackPanel><TextBlock Text="Catégorie" Margin="3,2"/><ComboBox Width="160" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" IsEditable="False"/></StackPanel>
                            <StackPanel><TextBlock Text="Date" Margin="3,2"/><DatePicker Width="175" SelectedDate="{Binding TransactionDate}"/></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#9B2C35" Margin="3,5" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Ajouter la transaction" Command="{Binding AddCommand}"/><Button Content="Effacer les champs" Command="{Binding CancelCommand}" Background="#E7ECF4" Foreground="#24344D"/></StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Transactions" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D" Margin="3,0,3,8"/>
                        <WrapPanel>
                            <StackPanel><TextBlock Text="Recherche" Margin="3,2"/><TextBox Width="180" Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            <StackPanel><TextBlock Text="Type" Margin="3,2"/><ComboBox Width="145" ItemsSource="{Binding FilterTypes}" DisplayMemberPath="Label" SelectedItem="{Binding FilterType}"/></StackPanel>
                            <StackPanel><TextBlock Text="Catégorie" Margin="3,2"/><ComboBox Width="150" ItemsSource="{Binding Categories}" SelectedItem="{Binding FilterCategory}" IsEditable="False"/></StackPanel>
                            <StackPanel><TextBlock Text="Du" Margin="3,2"/><DatePicker Width="208" SelectedDateFormat="Short" SelectedDate="{Binding StartDate}"/></StackPanel>
                            <StackPanel><TextBlock Text="Au" Margin="3,2"/><DatePicker Width="208" SelectedDateFormat="Short" SelectedDate="{Binding EndDate}"/></StackPanel>
                            <StackPanel><TextBlock Text="Trier par" Margin="3,2"/><ComboBox Width="130" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"/></StackPanel>
                            <Button Content="Rechercher" Command="{Binding SearchCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Effacer les filtres" Command="{Binding ResetFiltersCommand}" Background="#E7ECF4" Foreground="#24344D" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Transactions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MinHeight="170" MaxHeight="300" Margin="3">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat={}{0:dd/MM/yyyy}}" Width="102"/>
                                <DataGridTextColumn Header="Libellé" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="130"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type,Converter={StaticResource TransactionTypeLabelConverter}}" Width="100"/>
                                <DataGridTextColumn Header="Montant" Binding="{Binding Amount,StringFormat={}{0:C}}" Width="112"/>
                                <DataGridTemplateColumn Header="Actions" Width="178"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="Modifier" Padding="8,5" Command="{Binding DataContext.EditCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                    <Button Content="Supprimer" Padding="8,5" Background="#9B3A43" Command="{Binding DataContext.DeleteCommand,RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Soldes et plafond de dépenses" FontSize="20" FontWeight="SemiBold" Foreground="#172B4D"/>
                        <TextBlock Text="Le solde total correspond à tous les revenus moins toutes les dépenses. Le montant restant correspond au plafond mensuel configuré moins les dépenses du mois en cours." Foreground="#64748B" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,0,0,10">
                            <StackPanel Margin="3,2"><TextBlock Text="Plafond de dépenses mensuel (€)" Margin="3,2"/><TextBox Width="220" Text="{Binding BudgetInput,UpdateSourceTrigger=PropertyChanged}" ToolTip="Aucun montant n’est présélectionné."/></StackPanel>
                            <Button Content="Enregistrer le plafond" Command="{Binding SaveBudgetCommand}" VerticalAlignment="Bottom"/>
                            <Button Content="Effacer le plafond" Command="{Binding ClearBudgetCommand}" Background="#E7ECF4" Foreground="#24344D" VerticalAlignment="Bottom"/>
                        </WrapPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,8,18,8">
                                <Border Background="#EEF4FC" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                    <StackPanel><TextBlock Text="Solde total" Foreground="#52647D" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalBalanceText}" FontSize="25" FontWeight="Bold" Foreground="#2864B4" TextWrapping="Wrap"/><TextBlock Text="Revenus enregistrés − dépenses enregistrées" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                                <Border Background="#F0F7F2" CornerRadius="10" Padding="14">
                                    <StackPanel><TextBlock Text="Budget mensuel restant" Foreground="#52647D" FontWeight="SemiBold"/><TextBlock Text="{Binding RemainingBudgetText}" FontSize="23" FontWeight="Bold" Foreground="#18794E" TextWrapping="Wrap"/><TextBlock Text="{Binding BudgetDescription}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
                                </Border>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Column="1" Height="255" Series="{Binding BudgetIndicatorsSeries}" XAxes="{Binding BudgetAxes}" YAxes="{Binding BudgetValueAxes}" LegendPosition="Hidden"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsChartsPage,Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="24">
                <TextBlock Text="Graphiques" FontSize="30" FontWeight="SemiBold" Foreground="#172B4D"/>
                <TextBlock Text="{Binding SelectedBudget.Name, StringFormat=Analyses pour {0}}" Foreground="#64748B" Margin="0,4,0,16"/>
                <Border Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,16">
                    <WrapPanel VerticalAlignment="Center">
                        <StackPanel><TextBlock Text="Période" Margin="3,2"/><ComboBox Width="190" ItemsSource="{Binding GraphPeriods}" SelectedItem="{Binding SelectedGraphPeriod}"/></StackPanel>
                        <StackPanel><TextBlock Text="Du" Margin="3,2"/><DatePicker Width="190" SelectedDateFormat="Short" SelectedDate="{Binding GraphStartDate}"/></StackPanel>
                        <StackPanel><TextBlock Text="Au" Margin="3,2"/><DatePicker Width="190" SelectedDateFormat="Short" SelectedDate="{Binding GraphEndDate}"/></StackPanel>
                        <Button Content="Actualiser les graphiques" Command="{Binding ApplyGraphFiltersCommand}" VerticalAlignment="Bottom"/>
                    </WrapPanel>
                </Border>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="Dépenses par catégorie" FontSize="17" FontWeight="SemiBold" Foreground="#24344D"/>
                            <Grid Height="310">
                                <lvc:PieChart Series="{Binding CategorySeries}" LegendPosition="Right" Visibility="{Binding HasCategoryExpenses,Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Aucune dépense sur cette période." Foreground="#788596" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCategoryExpenses}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="Revenus et dépenses par mois" FontSize="17" FontWeight="SemiBold" Foreground="#24344D"/>
                            <Grid Height="310">
                                <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyAxes}" LegendPosition="Top" Visibility="{Binding HasMonthlyActivity,Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Aucune transaction sur cette période." Foreground="#788596" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasMonthlyActivity}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                        <StackPanel><TextBlock Text="Ressources entrantes · 12 derniers mois" FontSize="17" FontWeight="SemiBold" Foreground="#24344D" TextWrapping="Wrap"/>
                            <Grid Height="300">
                                <lvc:CartesianChart Series="{Binding IncomeByMonthSeries}" XAxes="{Binding IncomeByMonthAxes}" LegendPosition="Hidden" Visibility="{Binding HasIncomeByMonth,Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Aucune ressource entrante sur les 12 derniers mois." Foreground="#788596" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasIncomeByMonth}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                        <StackPanel><TextBlock Text="Solde total et budget restant ce mois" FontSize="17" FontWeight="SemiBold" Foreground="#24344D" TextWrapping="Wrap"/>
                            <Grid Height="300">
                                <lvc:CartesianChart Series="{Binding BudgetIndicatorsSeries}" XAxes="{Binding BudgetAxes}" YAxes="{Binding BudgetValueAxes}" LegendPosition="Hidden" Visibility="{Binding HasBudgetIndicatorData,Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="Ajoutez des transactions ou définissez un plafond pour afficher ces indicateurs." Foreground="#788596" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasBudgetIndicatorData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

