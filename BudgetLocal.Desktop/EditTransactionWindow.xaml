<Window x:Class="BudgetLocal.Desktop.EditTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier une transaction" SizeToContent="WidthAndHeight"
        MinWidth="470" MaxWidth="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" Language="fr-BE" FontFamily="Segoe UI">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Modifier la transaction" FontSize="24" FontWeight="SemiBold" Foreground="#172B4D"/>
            <TextBlock Text="Vos changements ne seront appliqués qu’après avoir choisi Enregistrer." Foreground="#68778D" Margin="0,4,0,18" TextWrapping="Wrap"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,4"><TextBlock Text="Libellé"/><TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,4"><TextBlock Text="Montant (€)"/><TextBox x:Name="AmountInput"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,4"><TextBlock Text="Type"/><ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=TransactionTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Type}"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,4"><TextBlock Text="Catégorie"/><ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=Categories}" SelectedItem="{Binding Category,UpdateSourceTrigger=PropertyChanged}" IsEditable="False"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="Date"/><DatePicker x:Name="TransactionDatePicker"/></StackPanel>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="#B42318" TextWrapping="Wrap" Margin="2,8,2,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Annuler" Background="#E7ECF4" Foreground="#24344D" Click="Cancel_Click"/>
            <Button Content="Enregistrer" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>

